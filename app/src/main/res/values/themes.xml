<resources>
    <style name="Theme.AffissiaPlayer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorPrimary">@color/player_accent</item>
        <item name="colorPrimaryDark">@color/player_background</item>
        <item name="colorAccent">@color/player_accent</item>
    </style>

    <style name="Theme.AffissiaPlayer.Setup" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="colorPrimary">@color/player_accent</item>
        <item name="colorPrimaryDark">@color/player_background</item>
        <item name="colorAccent">@color/player_accent</item>
    </style>
</resources>
